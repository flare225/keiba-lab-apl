{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/v1/lab/user-mark-audit",
      "destination": "/api/lab-audit"
    },
    {
      "source": "/v1/lab/mark-comparison",
      "destination": "/api/lab-comparison"
    },
    {
      "source": "/(.*)",
      "destination": "/api/v116"
    }
  ],
  "functions": {
    "api/lab-audit.js": {
      "maxDuration": 35
    },
    "api/lab-comparison.js": {
      "maxDuration": 35
    }
  }
}
